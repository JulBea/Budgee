generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  name            String
  phone           String?
  country         String           @default("France")
  bridgeUserUuid  String?          @unique
  accounts        Account[]
  bankConnections BankConnection[]
  budgets         Budget[]
  goals           Goal[]
  bills           Bill[]
  familyMembers   FamilyMember[]
  createdAt       DateTime         @default(now())
}

enum ConnectionStatus {
  PENDING
  ACTIVE
  ERROR
  DISCONNECTED
}

model BankConnection {
  id               String           @id @default(uuid())
  user             User             @relation(fields: [userId], references: [id])
  userId           String
  provider         String           @default("bridge")
  providerItemId   String           @unique
  bankName         String
  status           ConnectionStatus @default(PENDING)
  accounts         Account[]
  lastSyncedAt     DateTime?
  createdAt        DateTime         @default(now())
}

model Account {
  id                String         @id @default(uuid())
  user              User           @relation(fields: [userId], references: [id])
  userId            String
  bankConnection    BankConnection? @relation(fields: [bankConnectionId], references: [id])
  bankConnectionId  String?
  providerAccountId String?        @unique
  name              String
  type              String         @default("Compte courant")
  balance           Decimal        @default(0)
  currency          String         @default("EUR")
  ibanLast4         String?
  hidden            Boolean        @default(false)
  transactions      Transaction[]
  goal              Goal?
  createdAt         DateTime       @default(now())
}

model Category {
  id           String        @id @default(uuid())
  name         String
  icon         String?
  type         CategoryType
  transactions Transaction[]
  budgets      Budget[]
}

enum CategoryType {
  INCOME
  EXPENSE
}

model Transaction {
  id                    String    @id @default(uuid())
  account               Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId             String
  category              Category? @relation(fields: [categoryId], references: [id])
  categoryId            String?
  providerTransactionId String?   @unique
  amount                Decimal
  description           String
  date                  DateTime  @default(now())
}

model Budget {
  id         String       @id @default(uuid())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  category   Category     @relation(fields: [categoryId], references: [id])
  categoryId String
  limit      Decimal
  period     BudgetPeriod @default(MONTHLY)
  createdAt  DateTime     @default(now())

  @@unique([userId, categoryId, period])
}

enum BudgetPeriod {
  MONTHLY
  YEARLY
}

model Goal {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  target    Decimal
  saved     Decimal  @default(0)
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId String?  @unique
  createdAt DateTime @default(now())
}

enum BillStatus {
  PENDING
  PAID
}

model Bill {
  id        String     @id @default(uuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  amount    Decimal
  dueDate   DateTime
  status    BillStatus @default(PENDING)
  createdAt DateTime   @default(now())
}

model FamilyMember {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  role      String
  color     String   @default("#3A3564")
  spent     Decimal  @default(0)
  createdAt DateTime @default(now())
}
